        },
        {
          "term": "fastest to slowest",
          "definition": "Registers first, HBM last.",
          "anchor": "d10-p01"
        }
      ],
      "recall": [
        {
          "id": "d10-r1",
          "question": "D10 (P15). Name the GPU memory levels from fastest to slowest.",
          "answer": "Registers, shared memory/L1, L2, HBM.",
          "anchor": "d10-p01"
        }
      ],
