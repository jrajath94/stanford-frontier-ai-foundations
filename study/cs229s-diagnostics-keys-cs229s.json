    {
      "anchor": "d11",
      "title": "D11",
      "endAnchor": "d11-end",
      "blocks": [
        {
          "anchor": "d11-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "condition number",
          "definition": "How input errors amplify in the solution.",
          "anchor": "d11-p01"
        },
        {
          "term": "ill-conditioned",
          "definition": "1e6: errors can grow a million-fold.",
          "anchor": "d11-p01"
        }
      ],
      "recall": [
        {
          "id": "d11-r1",
          "question": "D11 (P04). A matrix has condition number 1e6. In one sentence, what does that say about solving linear systems with it?",
          "answer": "A condition number of 1e6 means the system is ill-conditioned: small input errors can grow ~1e6x in the solution.",
          "anchor": "d11-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d12",
      "title": "D12",
      "endAnchor": "d12-end",
      "blocks": [
        {
          "anchor": "d12-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "low-rank approximation",
          "definition": "Keep the top r singular components.",
          "anchor": "d12-p01"
        },
        {
          "term": "spectrum decay",
          "definition": "Fast decay: most energy in few components.",
          "anchor": "d12-p01"
        }
      ],
      "recall": [
        {
          "id": "d12-r1",
          "question": "D12 (P04). What is a low-rank approximation, and when does it save work?",
          "answer": "A low-rank approximation keeps the top r singular components. It saves work when the spectrum decays fast (most energy in few components).",
          "anchor": "d12-p01"
        }
      ],
      "minutes": 1
    }
  ]
