          "term": "tensor",
          "definition": "A (2,4,8) tensor holds 64 numbers.",
          "anchor": "d01-p01"
        },
        {
          "term": "transpose",
          "definition": "Swap the last two axes: (2, 8, 4).",
          "anchor": "d01-p01"
        }
      ],
      "recall": [
        {
          "id": "d01-r1",
          "question": "D01 (P12). A tensor has shape (2, 4, 8). How many numbers does it hold? Write the shape of its transpose over the last two axes.",
          "answer": "64 numbers. Transpose over last two axes: (2, 8, 4).",
          "anchor": "d01-p01"
        }
