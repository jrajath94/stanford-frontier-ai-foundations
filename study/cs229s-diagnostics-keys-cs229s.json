          "anchor": "d02-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "broadcasting",
          "definition": "Aligns trailing axes and stretches size-1 axes.",
          "anchor": "d02-p01"
        },
        {
          "term": "trailing axes",
          "definition": "Alignment starts from the rightmost axis.",
          "anchor": "d02-p01"
        }
      ],
      "recall": [
        {
          "id": "d02-r1",
          "question": "D02 (P12). Define broadcasting. Give the result shape of (4, 1) + (8,).",
          "answer": "Broadcasting aligns trailing axes and stretches size-1 axes. (4, 1) + (8,) -> (4, 8).",
          "anchor": "d02-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d03",
      "title": "D03",
      "endAnchor": "d03-end",
      "blocks": [
        {
          "anchor": "d03-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "gradient descent",
          "definition": "theta := theta - eta * dL/dtheta.",
          "anchor": "d03-p01"
        },
        {
          "term": "learning rate",
          "definition": "eta: the step size.",
          "anchor": "d03-p01"
        }
      ],
      "recall": [
        {
          "id": "d03-r1",
          "question": "D03 (P11). Write one gradient-descent step for a scalar parameter. Name each symbol.",
          "answer": "theta := theta - eta * dL/dtheta. theta: parameter. eta: learning rate. dL/dtheta: gradient of the loss.",
          "anchor": "d03-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d04",
      "title": "D04",
      "endAnchor": "d04-end",
      "blocks": [
        {
          "anchor": "d04-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "backward cost",
          "definition": "2F for a dense layer.",
          "anchor": "d04-p01"
        },
        {
          "term": "two grads",
          "definition": "One F for input grads, one F for weight grads.",
          "anchor": "d04-p01"
        }
      ],
      "recall": [
        {
          "id": "d04-r1",
          "question": "D04 (P11). Forward pass costs F FLOPs for a dense layer. What does the backward pass cost, and why?",
          "answer": "2F: one F for gradients w.r.t. inputs, one F for gradients w.r.t. weights (dense layer).",
          "anchor": "d04-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d05",
      "title": "D05",
      "endAnchor": "d05-end",
      "blocks": [
        {
          "anchor": "d05-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "perplexity",
          "definition": "exp(mean negative log-likelihood).",
          "anchor": "d05-p01"
        },
        {
          "term": "uniform baseline",
          "definition": "Perplexity equals vocabulary size.",
          "anchor": "d05-p01"
        }
      ],
      "recall": [
        {
          "id": "d05-r1",
          "question": "D05 (P13). Define perplexity in one sentence. A uniform model over 1000 tokens has what perplexity?",
          "answer": "Perplexity is exp(mean negative log-likelihood). The uniform model has perplexity 1000.",
          "anchor": "d05-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d06",
      "title": "D06",
      "endAnchor": "d06-end",
      "blocks": [
        {
          "anchor": "d06-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "teacher forcing",
          "definition": "Feed true previous tokens during training.",
          "anchor": "d06-p01"
        },
        {
          "term": "exposure bias",
          "definition": "The train/test mismatch it creates.",
          "anchor": "d06-p01"
        }
      ],
      "recall": [
        {
          "id": "d06-r1",
          "question": "D06 (P13). What is teacher forcing?",
          "answer": "Teacher forcing feeds the true previous tokens as inputs during training instead of the model’s own predictions.",
          "anchor": "d06-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d07",
      "title": "D07",
      "endAnchor": "d07-end",
      "blocks": [
        {
          "anchor": "d07-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "head dim",
          "definition": "d = n/h = 4.",
          "anchor": "d07-p01"
        },
        {
          "term": "merged output",
          "definition": "(1, 4, 8): heads folded back into n.",
          "anchor": "d07-p01"
        }
      ],
      "recall": [
        {
          "id": "d07-r1",
          "question": "D07 (P14). For n = 8, h = 2, T = 4: write the shapes of Q, the score matrix, and the merged attention output at batch 1.",
          "answer": "d = 4. Q: (1, 2, 4, 4). Scores: (1, 2, 4, 4). Merged output: (1, 4, 8).",
          "anchor": "d07-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d08",
      "title": "D08",
      "endAnchor": "d08-end",
      "blocks": [
        {
          "anchor": "d08-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "KV cache",
          "definition": "Past keys and values per layer.",
          "anchor": "d08-p01"
        },
        {
          "term": "read not recompute",
          "definition": "New step computes only its own K/V.",
          "anchor": "d08-p01"
        }
      ],
      "recall": [
        {
          "id": "d08-r1",
          "question": "D08 (P14). What does the KV cache store, and why does it avoid recomputation?",
          "answer": "The cache stores past keys and values per layer. A new step needs only its own K/V, the rest are read, not recomputed.",
          "anchor": "d08-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d09",
      "title": "D09",
      "endAnchor": "d09-end",
      "blocks": [
        {
          "anchor": "d09-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "arithmetic intensity",
          "definition": "FLOPs per byte, in FLOP/byte.",
          "anchor": "d09-p01"
        },
        {
          "term": "ridge 150",
          "definition": "Below it: memory-bound.",
          "anchor": "d09-p01"
        }
      ],
      "recall": [
        {
          "id": "d09-r1",
          "question": "D09 (P15). Define arithmetic intensity with units. A kernel does 1e9 FLOPs and moves 1e9 bytes. What is its intensity, and which roofline side is it on at ridge 150?",
          "answer": "I = FLOPs/bytes = 1 FLOP/byte. Below ridge 150: memory-bound.",
          "anchor": "d09-p01"
        }
      ],
      "minutes": 1
    },
