  {
   "anchor": "c01-k-means",
   "title": "C01, k-means",
   "minutes": 3,
   "endAnchor": "c01-k-means-end",
   "blocks": [
    {
     "anchor": "c01-k-means-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "c01-k-means-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "Lloyd",
     "definition": "Assign to the nearest center, move each center to its group's mean.",
     "anchor": "c01-k-means-p03"
    },
    {
     "term": "objective",
     "definition": "J = sum ||x_i - mu_{a_i}||^2: each step lowers or holds it.",
     "anchor": "c01-k-means-p03"
    }
   ],
   "recall": [
    {
     "id": "c01-k-means-r1",
     "question": "What did the iterations do?",
     "answer": "J 0.1700 -> 0.133333 -> converged; the bad start went 145.17 -> 9.03625 -> 0.133333.",
     "anchor": "c01-k-means-p05"
    },
    {
     "id": "c01-k-means-r2",
     "question": "What is the empty-cluster guard?",
     "answer": "Keep the old center: the mean of nothing is undefined.",
     "anchor": "c01-k-means-p12"
    }
   ]
  },
  {
   "anchor": "c02-distance-and-scaling",
   "title": "C02, distance and scaling",
   "minutes": 2,
   "endAnchor": "c02-distance-and-scaling-end",
   "blocks": [
    {
     "anchor": "c02-distance-and-scaling-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "c02-distance-and-scaling-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "flip",
     "definition": "Scaling y by 5 flips the nearest neighbor from B to C.",
     "anchor": "c02-distance-and-scaling-p03"
    },
    {
     "term": "standardization",
     "definition": "Zero mean, unit variance per column: the default honest ruler.",
     "anchor": "c02-distance-and-scaling-p03"
    }
   ],
   "recall": [
    {
     "id": "c02-distance-and-scaling-r1",
     "question": "What were the three nearest-neighbor verdicts?",
     "answer": "Raw: B. Scaled: C. Standardized: B again.",
     "anchor": "c02-distance-and-scaling-p05"
    },
    {
     "id": "c02-distance-and-scaling-r2",
     "question": "What breaks standardization?",
     "answer": "A constant column: division by zero. Check variances first.",
     "anchor": "c02-distance-and-scaling-p11"
    }
   ]
  },
  {
   "anchor": "c03-pca",
   "title": "C03, PCA",
   "minutes": 2,
   "endAnchor": "c03-pca-end",
   "blocks": [
    {
     "anchor": "c03-pca-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "c03-pca-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "PCA",
     "definition": "Maximum-variance directions: eigenvectors of the covariance.",
     "anchor": "c03-pca-p03"
    },
    {
     "term": "variance explained",
     "definition": "PC1 holds 99.72 percent here.",
     "anchor": "c03-pca-p03"
    }
   ],
   "recall": [
    {
     "id": "c03-pca-r1",
     "question": "What are the eigenvalues?",
     "answer": "6.541656 and 0.018344; trace and determinant both check.",
     "anchor": "c03-pca-p05"
    },
    {
     "id": "c03-pca-r2",
     "question": "What does forgetting to center do?",
     "answer": "PC1 chases the mean instead of the spread.",
     "anchor": "c03-pca-p11"
    }
   ]
  },
  {
   "anchor": "c04-reconstruction",
   "title": "C04, reconstruction",
   "minutes": 2,
   "endAnchor": "c04-reconstruction-end",
   "blocks": [
    {
     "anchor": "c04-reconstruction-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "c04-reconstruction-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "identity",
     "definition": "Per-entry MSE = sum of dropped eigenvalues / d: 0.009172.",
     "anchor": "c04-reconstruction-p03"
    },
    {
     "term": "optimal",
     "definition": "No other rank-1 linear map has smaller squared error: Eckart-Young.",
     "anchor": "c04-reconstruction-p03"
    }
   ],
   "recall": [
    {
     "id": "c04-reconstruction-r1",
     "question": "Verify the identity.",
     "answer": "Dropped eigenvalue 0.018344 / 2 = 0.009172 = measured MSE.",
     "anchor": "c04-reconstruction-p05"
    },
    {
     "id": "c04-reconstruction-r2",
     "question": "When is PCA not optimal?",
     "answer": "Under absolute error, or on curved data: chords through empty space.",
     "anchor": "c04-reconstruction-p11"
    }
   ]
  },
  {
   "anchor": "c09-factor-models-bridge",
   "title": "C09, factor models bridge",
   "minutes": 3,
   "endAnchor": "c09-factor-models-bridge-end",
   "blocks": [
    {
     "anchor": "c09-factor-models-bridge-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "c09-factor-models-bridge-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "factor model",
     "definition": "x = W z + mu + eps: per-dimension noise Psi.",
     "anchor": "c09-factor-models-bridge-p03"
    },
    {
     "term": "PCA case",
     "definition": "Psi = sigma^2 I: equal noise everywhere.",
     "anchor": "c09-factor-models-bridge-p03"
    }
   ],
   "recall": [
    {
     "id": "c09-factor-models-bridge-r1",
     "question": "Why does the second eigenvalue 3.83 exist?",
     "answer": "PCA spends a whole direction on the noisy sensor.",
     "anchor": "c09-factor-models-bridge-p05"
    },
    {
     "id": "c09-factor-models-bridge-r2",
     "question": "When does a factor model beat PCA?",
     "answer": "When noise differs by dimension: the 30x noisier sensor.",
     "anchor": "c09-factor-models-bridge-p05"
    }
   ]
  },
  {
   "anchor": "c12-held-out-evaluation",
