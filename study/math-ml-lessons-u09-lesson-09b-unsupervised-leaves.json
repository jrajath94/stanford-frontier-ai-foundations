    {
     "term": "elbow",
     "definition": "Where extra centers stop buying real structure: k = 2 here.",
     "anchor": "c12-held-out-evaluation-p03"
    }
   ],
   "recall": [
    {
     "id": "c12-held-out-evaluation-r1",
     "question": "What are the held-out numbers?",
     "answer": "14.1768, 0.4439, 0.3360, 0.2939: drop of 13.73 then 0.15.",
     "anchor": "c12-held-out-evaluation-p05"
    },
    {
     "id": "c12-held-out-evaluation-r2",
     "question": "Why can't train inertia pick k?",
     "answer": "It is monotone: k = n wins with inertia zero.",
     "anchor": "c12-held-out-evaluation-p05"
    }
   ]
