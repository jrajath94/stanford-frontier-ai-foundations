      ],
      "recall": [
        {
          "id": "o3-r1",
          "question": "O3a. Define iteration-level scheduling.",
          "answer": "The batch re-forms every decode iteration.",
          "anchor": "o3-p01"
        },
        {
          "id": "o3-r2",
          "question": "O3f. Decodes stall on every long prompt. Name the missing mechanism.",
          "answer": "Missing chunked prefill: whole prefills stall decodes.",
          "anchor": "o3-p01"
        }
      ],
      "minutes": 1
