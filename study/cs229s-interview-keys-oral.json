        {
          "term": "top-k routing",
          "definition": "Score experts, keep top-k, renormalize.",
          "anchor": "o4-p01"
        },
        {
          "term": "capacity",
          "definition": "(tokens*k/experts)*factor; overflow drops.",
          "anchor": "o4-p01"
        },
        {
          "term": "balance loss",
          "definition": "Over-weighted kills specialization; under-weighted collapses.",
          "anchor": "o4-p01"
        }
      ],
      "recall": [
        {
          "id": "o4-r1",
          "question": "O4a. Define top-k expert routing.",
          "answer": "Score experts, keep top-k, renormalize, weight the outputs.",
          "anchor": "o4-p01"
        },
        {
          "id": "o4-r2",
          "question": "O4g. The balance loss fixes skew, but at what price?",
          "answer": "Over-weighted: uniform routing kills specialization. Under-weighted: collapse.",
          "anchor": "o4-p01"
        }
      ],
      "minutes": 1
