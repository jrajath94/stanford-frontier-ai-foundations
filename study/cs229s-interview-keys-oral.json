          "term": "iteration-level scheduling",
          "definition": "The batch re-forms every decode iteration.",
          "anchor": "o3-p01"
        },
        {
          "term": "formation wait",
          "definition": "The 0.5 s gap: waiting, not speed.",
          "anchor": "o3-p01"
        },
        {
          "term": "chunked prefill",
          "definition": "Splits big prefills so decodes stop stalling.",
          "anchor": "o3-p01"
