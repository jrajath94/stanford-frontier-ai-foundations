      "keyTerms": [
        {
          "term": "attention bottleneck",
          "definition": "Materializing the T x T score matrix.",
          "anchor": "o1-p01"
        },
        {
          "term": "online softmax",
          "definition": "Running max and normalizer per block.",
          "anchor": "o1-p01"
        },
        {
          "term": "exactness",
          "definition": "Wins when sharp selection decides quality.",
          "anchor": "o1-p01"
        }
      ],
      "recall": [
        {
          "id": "o1-r1",
          "question": "O1a. Define the attention bottleneck in one sentence.",
          "answer": "Attention materializes a T x T score matrix: O(T^2) memory and traffic dominate.",
          "anchor": "o1-p01"
        },
        {
          "id": "o1-r2",
          "question": "O1e. Compare FlashAttention to a sparse approximation: when does exactness win?",
          "answer": "Exactness wins when sharp selection decides quality (copy, retrieval). Approximation when the task is smooth.",
          "anchor": "o1-p01"
        }
      ],
      "minutes": 1
