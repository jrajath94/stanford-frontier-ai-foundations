  "sections": [
    {
      "anchor": "cs229s-interview-keys-u05-intro",
      "title": "Interview answer keys, U05",
      "endAnchor": "cs229s-interview-keys-u05-intro-end",
      "blocks": [],
      "keyTerms": [
        {
          "term": "answer key",
          "definition": "Minimum sufficient explanation, strong answer, red flags, rubric, remediation per item.",
          "anchor": "cs229s-interview-keys-u05-intro-p02"
        },
        {
          "term": "remediation",
          "definition": "The lesson concept to revisit, e.g. C01 toy.",
          "anchor": "cs229s-interview-keys-u05-intro-p02"
        }
      ],
      "recall": [
        {
          "id": "cs229s-interview-keys-u05-intro-r1",
          "question": "What does each answer in this key contain?",
          "answer": "The minimum sufficient explanation, a strong answer, red flags, a rubric, and remediation.",
          "anchor": "cs229s-interview-keys-u05-intro-p02"
        }
      ],
      "minutes": 4
    },
    {
      "anchor": "b1",
      "title": "B1",
      "endAnchor": "b1-end",
      "blocks": [
        {
          "anchor": "b1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "scale s",
          "definition": "(max-min)/(2^b-1): the level spacing.",
          "anchor": "b1-p01"
        },
        {
          "term": "zero point z",
          "definition": "The integer level for 0.0.",
          "anchor": "b1-p01"
        }
      ],
      "recall": [
        {
          "id": "b1-r1",
          "question": "B1. Write the four linear quantization formulas (s, z, x_q, x_hat).",
          "answer": "s=(max-min)/(2^b-1), z=round(-min/s), x_q=clamp(round(x/s)+z), x_hat=s*(x_q-z).",
          "anchor": "b1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b2",
      "title": "B2",
      "endAnchor": "b2-end",
      "blocks": [
        {
          "anchor": "b2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "s/2 bound",
          "definition": "Nearest mark is at most half a spacing away.",
          "anchor": "b2-p01"
        },
        {
          "term": "clipping",
          "definition": "Out-of-range values snap to the edge.",
          "anchor": "b2-p01"
        }
      ],
      "recall": [
        {
          "id": "b2-r1",
          "question": "B2. State the in-range rounding error bound. What is the second error source?",
          "answer": "|err| <= s/2 in range. Second source: clipping (out-of-range values snap to the edge).",
          "anchor": "b2-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b3",
      "title": "B3",
      "endAnchor": "b3-end",
      "blocks": [
        {
          "anchor": "b3-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "per-channel",
          "definition": "One (s,z) per row.",
          "anchor": "b3-p01"
        },
        {
          "term": "100x-range example",
          "definition": "Where per-tensor dies.",
          "anchor": "b3-p01"
        }
      ],
      "recall": [
        {
          "id": "b3-r1",
          "question": "B3. Define per-tensor, per-channel, per-group quantization. When is per-tensor unsafe?",
          "answer": "Per-tensor: one (s,z). Per-channel: one per row. Per-group: one per g elements. Per-tensor unsafe when channels span very different ranges.",
          "anchor": "b3-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b4",
      "title": "B4",
      "endAnchor": "b4-end",
      "blocks": [
        {
          "anchor": "b4-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "weight-only",
          "definition": "int8 weights, fp16 activations.",
          "anchor": "b4-p01"
        },
        {
          "term": "static vs dynamic",
          "definition": "Fixed ranges vs per-batch ranges.",
          "anchor": "b4-p01"
        }
      ],
      "recall": [
        {
          "id": "b4-r1",
          "question": "B4. Contrast weight-only vs W8A8 quantization, and static vs dynamic activation quantization.",
          "answer": "Weight-only: int8 weights, fp16 acts. W8A8: both int8. Static: fixed ranges. Dynamic: per-batch ranges.",
          "anchor": "b4-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b5",
      "title": "B5",
      "endAnchor": "b5-end",
      "blocks": [
        {
          "anchor": "b5-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "percentile",
          "definition": "Clips the outlier tail.",
          "anchor": "b5-p01"
        },
        {
          "term": "MSE search",
          "definition": "Picks the range minimizing total error.",
          "anchor": "b5-p01"
        }
      ],
      "recall": [
        {
          "id": "b5-r1",
          "question": "B5. Name three calibration range-picking methods. Which fails with outliers, and why?",
          "answer": "Min/max, percentile, MSE search. Min/max fails: one giant sets the scale (500x too coarse).",
          "anchor": "b5-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b6",
      "title": "B6",
      "endAnchor": "b6-end",
      "blocks": [
        {
          "anchor": "b6-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "2:4 sparsity",
          "definition": "Exactly 2 nonzeros per 4.",
          "anchor": "b6-p01"
        },
        {
          "term": "pattern support",
          "definition": "What the hardware skips.",
          "anchor": "b6-p01"
        }
      ],
      "recall": [
        {
          "id": "b6-r1",
          "question": "B6. Define 2:4 sparsity. Why does the pattern matter more than the sparsity count?",
          "answer": "Exactly 2 nonzeros per 4 consecutive elements. Hardware skips only supported patterns; unstructured pays index overhead (~1x vs ~1.8x).",
          "anchor": "b6-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b7",
      "title": "B7",
      "endAnchor": "b7-end",
      "blocks": [
        {
          "anchor": "b7-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "magnitude pruning",
          "definition": "Zero the smallest-|w| fraction.",
          "anchor": "b7-p01"
        },
        {
          "term": "proxy",
          "definition": "Magnitude is only a proxy for importance.",
          "anchor": "b7-p01"
        }
      ],
      "recall": [
        {
          "id": "b7-r1",
          "question": "B7. Define magnitude pruning. Name two upgrades.",
          "answer": "Zero the smallest-|w| fraction. Upgrades: sensitivity-guided, gradual + retrain. Magnitude is only a proxy.",
          "anchor": "b7-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b8",
      "title": "B8",
      "endAnchor": "b8-end",
      "blocks": [
        {
          "anchor": "b8-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "butterfly",
          "definition": "2n log n params from log n factors of 2n.",
          "anchor": "b8-p01"
        },
        {
          "term": "51x fewer",
          "definition": "At n=1024 vs dense.",
          "anchor": "b8-p01"
        }
      ],
      "recall": [
        {
          "id": "b8-r1",
          "question": "B8. Write the butterfly parameter count. Give the n=1024 number vs dense.",
          "answer": "2n log n. n=1024: 20,480 vs ~1M dense (51x fewer).",
          "anchor": "b8-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "deep-ladder-1",
      "title": "Deep ladder 1",
      "endAnchor": "deep-ladder-1-end",
      "blocks": [
        {
          "anchor": "deep-ladder-1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "level spacing",
          "definition": "s = (max-min)/(2^b-1).",
          "anchor": "deep-ladder-1-p01"
        },
        {
          "term": "quiet channel",
          "definition": "Crushed to ~1 level under per-tensor.",
          "anchor": "deep-ladder-1-p01"
        },
        {
          "term": "clip sweep",
          "definition": "U-shaped MSE; the argmin is the pick.",
          "anchor": "deep-ladder-1-p01"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-1-r1",
          "question": "Deep ladder 1: quantization economics. Define s and z, run the [-1,1] 4-bit toy, prove the s/2 bound.",
          "answer": "s=0.1333, z=8, x_q=12, x_hat=0.5333 for 0.5. Nearest mark at most half a spacing away. Per-tensor crushes the quiet channel (MSE ~0.28 vs 0.0013).",
          "anchor": "deep-ladder-1-p01"
        }
      ],
      "minutes": 3
    },
    {
      "anchor": "deep-ladder-2",
      "title": "Deep ladder 2",
      "endAnchor": "deep-ladder-2-end",
      "blocks": [
        {
          "anchor": "deep-ladder-2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "realized time",
          "definition": "Measured time, not the FLOP ratio.",
          "anchor": "deep-ladder-2-p01"
        },
        {
          "term": "gather overhead",
          "definition": "What eats the math saving.",
          "anchor": "deep-ladder-2-p01"
        },
        {
          "term": "2:4 needs hardware",
          "definition": "Without sparse tensor cores it runs as dense.",
          "anchor": "deep-ladder-2-p01"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-2-r1",
          "question": "Deep ladder 2: sparsity reality. Define realized speed, run the 50% sparse toy, derive the ~1x case.",
          "answer": "Dense 100 us, 50% sparse: 95 us (1.05x) at 45 us gather, 55 us (1.8x) at 5 us. Unstructured ~1x, 2:4 ~1.8x, needs sparse tensor cores.",
          "anchor": "deep-ladder-2-p01"
        }
      ],
      "minutes": 2
    },
    {
      "anchor": "a1",
      "title": "A1",
      "endAnchor": "a1-end",
      "blocks": [
        {
          "anchor": "a1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "per-tensor s",
          "definition": "13.33: set by the loud channel.",
          "anchor": "a1-p01"
        },
        {
          "term": "225x ratio",
          "definition": "Per-channel wins on the quiet channel.",
          "anchor": "a1-p01"
        }
      ],
      "recall": [
        {
          "id": "a1-r1",
          "question": "A1. W has rows in [-100,100] and [-1,1], 4-bit. Compare the quiet channel’s MSE under per-tensor vs per-channel.",
          "answer": "Per-tensor s=13.33: MSE ~0.333. Per-channel s=0.1333: MSE ~0.00148. Ratio ~225x.",
          "anchor": "a1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "a2",
      "title": "A2",
      "endAnchor": "a2-end",
      "blocks": [
        {
          "anchor": "a2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "error bound",
          "definition": "0.02*2.0 + 0.02 = 0.06.",
          "anchor": "a2-p01"
        },
        {
          "term": "early precision",
          "definition": "Early error gets multiplied.",
          "anchor": "a2-p01"
        }
      ],
      "recall": [
        {
          "id": "a2-r1",
          "question": "A2. Two layers, per-layer error 0.02, Lipschitz [1.0, 2.0] vs swapped. Which layer keeps more precision?",
          "answer": "Order [1.0,2.0]: bound 0.06. Swapped: 0.04. Keep more precision early when later layers amplify.",
          "anchor": "a2-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d1",
      "title": "D1",
      "endAnchor": "d1-end",
      "blocks": [
        {
          "anchor": "d1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "hardcoded z",
          "definition": "The bug.",
          "anchor": "d1-p01"
        },
        {
          "term": "zero invariant",
          "definition": "dq(q(0.0)) == 0.0 exactly.",
          "anchor": "d1-p01"
        }
      ],
      "recall": [
        {
          "id": "d1-r1",
          "question": "D1. The quantizer looks right but quantize(0) does not decode to 0. Find the bug, fix it, state the invariant.",
          "answer": "Bug: z = 0 hardcoded. Fix: z = round(-min/s). Invariant: dq(q(0.0)) == 0.0 exactly.",
          "anchor": "d1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "s1",
      "title": "S1",
      "endAnchor": "s1-end",
      "blocks": [
        {
          "anchor": "s1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "per-element",
          "definition": "Optimal but metadata-heavy.",
          "anchor": "s1-p01"
        },
        {
          "term": "per-group",
          "definition": "The practical optimum.",
          "anchor": "s1-p01"
        }
      ],
      "recall": [
        {
          "id": "s1-r1",
          "question": "S1. Scales are free (zero storage, zero compute). What is the optimal granularity, and what limits it?",
          "answer": "Per-element scales would be optimal, but scale storage then equals data storage. Practical: per-group with small g.",
          "anchor": "s1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "s2",
      "title": "S2",
      "endAnchor": "s2-end",
      "blocks": [
        {
          "anchor": "s2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "zero budget",
          "definition": "No approximate method meets it strictly.",
          "anchor": "s2-p01"
        },
        {
          "term": "reframe",
          "definition": "Prove deltas are noise, or call it inconsistent.",
          "anchor": "s2-p01"
        }
      ],
      "recall": [
        {
          "id": "s2-r1",
          "question": "S2. The error budget is zero but memory must halve. Compare int8, 2:4 sparsity, butterfly. Which do you pick?",
          "answer": "No method meets both literally. Nearest: int8 with task deltas zero within eval noise, else the constraints are inconsistent.",
          "anchor": "s2-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "r1",
      "title": "R1",
      "endAnchor": "r1-end",
      "blocks": [
        {
          "anchor": "r1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "task audit",
          "definition": "Perplexity-only invalidates.",
          "anchor": "r1-p01"
        },
        {
          "term": "seed audit",
          "definition": "One run invalidates.",
          "anchor": "r1-p01"
        }
      ],
      "recall": [
        {
          "id": "r1-r1",
          "question": "R1. A paper claims “4-bit weights with no quality loss on all tasks.” List five audit questions.",
          "answer": "(1) Which tasks? (2) Baseline tuned? (3) Granularity and calibration reported? (4) Seeds and error bars? (5) Outlier-sensitive tasks?",
          "anchor": "r1-p01"
        }
      ],
      "minutes": 1
    }
  ]
}
