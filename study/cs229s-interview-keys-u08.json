        {
          "term": "fail fast",
          "definition": "Fast reject beats an SLO miss.",
          "anchor": "changed-constraint-answers-p01"
        }
      ],
      "recall": [
        {
          "id": "changed-constraint-answers-r1",
          "question": "Interconnect bandwidth is infinite. Does MoE still beat dense?",
          "answer": "Dispatch free but MoE still pays gate compute, balance loss, drops, routing risk. Dense wins on simplicity.",
          "anchor": "changed-constraint-answers-p01"
        },
        {
          "id": "changed-constraint-answers-r2",
          "question": "Every request has a hard 10 s SLO and arrivals are adversarial. Redesign admission, scheduling, eviction.",
          "answer": "Bounded queue with fast reject, mandatory chunked prefill, earliest-deadline-first eviction, shed load early.",
          "anchor": "changed-constraint-answers-p02"
        }
      ],
      "minutes": 1
