    {
      "anchor": "breadth-answers",
      "title": "Breadth answers",
      "endAnchor": "breadth-answers-end",
      "blocks": [
        {
          "anchor": "breadth-answers-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "continuous batching",
          "definition": "Batch re-forms every iteration.",
          "anchor": "breadth-answers-p01"
        },
        {
          "term": "Little's law",
          "definition": "Concurrency = throughput * mean latency.",
          "anchor": "breadth-answers-p01"
        },
        {
          "term": "expert capacity",
          "definition": "Overflow tokens drop.",
          "anchor": "breadth-answers-p01"
        },
        {
          "term": "chunked prefill",
          "definition": "Splits big prefills so decodes stop stalling.",
          "anchor": "breadth-answers-p01"
        }
      ],
      "recall": [
        {
          "id": "breadth-answers-r1",
          "question": "Define continuous batching. What wait does it remove?",
          "answer": "The batch re-forms every iteration, admitting arrivals at once. It removes batch-formation waiting.",
          "anchor": "breadth-answers-p01"
        },
        {
          "id": "breadth-answers-r2",
          "question": "Define p99 and state Little’s law. Why do means lie?",
          "answer": "p99: latency 99% beat. Little: concurrency = throughput * mean latency. Means hide the tail.",
          "anchor": "breadth-answers-p05"
        },
        {
          "id": "breadth-answers-r3",
          "question": "Write the expert capacity formula. What happens past capacity?",
          "answer": "Capacity = (tokens*k/experts)*factor. Past capacity, tokens drop.",
          "anchor": "breadth-answers-p07"
        }
      ],
      "minutes": 3
    },
    {
