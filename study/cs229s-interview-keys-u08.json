        {
          "term": "gate collapse",
          "definition": "No auxiliary balance loss.",
          "anchor": "debug-answer-p01"
        },
        {
          "term": "token-share invariant",
          "definition": "Every expert gets tokens each epoch.",
          "anchor": "debug-answer-p01"
        }
      ],
      "recall": [
        {
          "id": "debug-answer-r1",
          "question": "The router trains, but 7 of 8 experts never receive tokens after the first epoch. Bug class, fix, invariant?",
          "answer": "Bug class: missing load-balance term (gate collapse). Fix: auxiliary balance loss. Invariant: every expert receives a nontrivial token share each epoch.",
          "anchor": "debug-answer-p01"
        }
      ],
