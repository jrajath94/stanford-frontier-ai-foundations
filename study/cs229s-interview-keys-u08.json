        },
        {
          "term": "chunked prefill",
          "definition": "The missing mechanism.",
          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "term": "burst replay",
          "definition": "Replay bursty traces through both schedulers.",
          "anchor": "deep-ladder-1-answers-p02"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-1-answers-r1",
          "question": "4 requests at t=0,1,2,3, 10 tokens at 0.1 s/token. Compute continuous vs static mean latency.",
          "answer": "Continuous 1.0 s, static 1.5 s.",
          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "id": "deep-ladder-1-answers-r2",
          "question": "Decodes stall 0.25 s on every new arrival. Name the missing mechanism.",
          "answer": "Missing chunked prefill: whole prefills stall the decodes.",
          "anchor": "deep-ladder-1-answers-p06"
        }
      ],
      "minutes": 3
    },
