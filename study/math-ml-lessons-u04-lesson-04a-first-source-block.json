    }
   ],
   "keyTerms": [
    {
     "term": "expectation",
     "definition": "The probability-weighted average, the long-run center.",
     "anchor": "sb04-expectation-and-variance-recap-u04-c04-p03"
    },
    {
     "term": "variance",
     "definition": "The average squared stray from the center.",
     "anchor": "sb04-expectation-and-variance-recap-u04-c04-p03"
    },
    {
     "term": "linearity",
     "definition": "E[aX + b] = a E[X] + b, no independence needed.",
     "anchor": "sb04-expectation-and-variance-recap-u04-c04-p05"
    }
   ],
   "recall": [
    {
     "id": "sb04-expectation-and-variance-recap-u04-c04-r1",
     "question": "What are the mean and variance of a fair die?",
     "answer": "E = 3.5, Var = 35/12 = 2.9167.",
     "anchor": "sb04-expectation-and-variance-recap-u04-c04-p06"
    },
    {
     "id": "sb04-expectation-and-variance-recap-u04-c04-r2",
     "question": "Which distribution has no finite expectation?",
     "answer": "Cauchy: the average of samples never settles.",
     "anchor": "sb04-expectation-and-variance-recap-u04-c04-p10"
    }
   ]
  },
