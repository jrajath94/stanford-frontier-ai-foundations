    }
   ],
   "keyTerms": [
    {
     "term": "likelihood",
     "definition": "P(data | parameter), read as a function of the parameter.",
     "anchor": "sb07-distribution-estimation-lec-08-u04-c06-c10-p03"
    },
    {
     "term": "MLE",
     "definition": "The parameter that makes the observed data most probable.",
     "anchor": "sb07-distribution-estimation-lec-08-u04-c06-c10-p03"
    },
    {
     "term": "density estimation",
     "definition": "The continuous cousin of MLE: histogram or KDE from points.",
     "anchor": "sb07-distribution-estimation-lec-08-u04-c06-c10-p05"
    }
   ],
   "recall": [
    {
     "id": "sb07-distribution-estimation-lec-08-u04-c06-c10-r1",
     "question": "What is the MLE for H, H, T, H?",
     "answer": "p_hat = 3/4 = 0.75, log-likelihood -2.2493.",
     "anchor": "sb07-distribution-estimation-lec-08-u04-c06-c10-p06"
    },
    {
     "id": "sb07-distribution-estimation-lec-08-u04-c06-c10-r2",
     "question": "Why does MLE overfit at n = 1?",
     "answer": "One flip gives p_hat = 1.0: certainty from one draw.",
     "anchor": "sb07-distribution-estimation-lec-08-u04-c06-c10-p12"
    }
   ]
