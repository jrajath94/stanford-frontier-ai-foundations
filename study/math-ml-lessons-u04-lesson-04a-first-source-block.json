  {
   "anchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01",
   "title": "SB02, PMF/PDF/CDF (Lec 09, recap) -&gt; U04-C01",
   "minutes": 2,
   "endAnchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-end",
   "blocks": [
    {
     "anchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "PMF",
     "definition": "A table for discrete X; rows sum to 1.",
     "anchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-p03"
    },
    {
     "term": "PDF",
     "definition": "A curve for continuous X; area under it is 1.",
     "anchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-p03"
    },
    {
     "term": "CDF",
     "definition": "The running total P(X <= x), climbing from 0 to 1.",
     "anchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-p03"
    }
   ],
   "recall": [
    {
     "id": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-r1",
     "question": "What is the CDF of Bernoulli(0.3)?",
     "answer": "F(0) = 0.7, F(1) = 1.0. CDF differences recover the PMF.",
     "anchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-p06"
    },
    {
     "id": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-r2",
     "question": "What is wrong with a table whose rows sum to 1.2?",
     "answer": "It is not a PMF. Normalize or reject.",
     "anchor": "sb02-pmfpdfcdf-lec-09-recap-u04-c01-p10"
    }
   ]
  },
  {
   "anchor": "sb03-jointmarginalconditional-recap-u04-c02",
