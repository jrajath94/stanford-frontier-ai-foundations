   "anchor": "sb06-the-iid-assumption-lec-07-u04-c11",
   "title": "SB06, the IID assumption (Lec 07) -&gt; U04-C11",
   "minutes": 2,
   "endAnchor": "sb06-the-iid-assumption-lec-07-u04-c11-end",
   "blocks": [
    {
     "anchor": "sb06-the-iid-assumption-lec-07-u04-c11-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb06-the-iid-assumption-lec-07-u04-c11-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "IID",
     "definition": "Independent and identically distributed.",
     "anchor": "sb06-the-iid-assumption-lec-07-u04-c11-p03"
    },
    {
     "term": "identical",
     "definition": "Every draw comes from the same P.",
     "anchor": "sb06-the-iid-assumption-lec-07-u04-c11-p05"
    },
    {
     "term": "independent",
     "definition": "Knowing draw 3 tells you nothing about draw 4.",
     "anchor": "sb06-the-iid-assumption-lec-07-u04-c11-p05"
    }
   ],
   "recall": [
    {
     "id": "sb06-the-iid-assumption-lec-07-u04-c11-r1",
     "question": "What is the IID joint of n draws?",
     "answer": "p(x_1..x_n) = prod_i p(x_i).",
     "anchor": "sb06-the-iid-assumption-lec-07-u04-c11-p05"
    },
    {
     "id": "sb06-the-iid-assumption-lec-07-u04-c11-r2",
     "question": "How does drift break IID?",
     "answer": "Time series with drift breaks identical: the sample mean estimates a moving target.",
     "anchor": "sb06-the-iid-assumption-lec-07-u04-c11-p11"
    }
   ]
  },
  {
   "anchor": "sb07-distribution-estimation-lec-08-u04-c06-c10",
   "title": "SB07, distribution estimation (Lec 08) -&gt; U04-C06, C10",
