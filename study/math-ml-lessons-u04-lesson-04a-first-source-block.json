   "minutes": 2,
   "endAnchor": "sb03-jointmarginalconditional-recap-u04-c02-end",
   "blocks": [
    {
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    },
    {
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "joint",
     "definition": "The full story: p(x, y) for every pair.",
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-p03"
    },
    {
     "term": "marginal",
     "definition": "Sum along one axis to forget a variable.",
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-p03"
    },
    {
     "term": "conditional",
     "definition": "Zoom into one row or column and renormalize.",
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-p03"
    },
    {
     "term": "Bayes",
     "definition": "Flips the zoom: P(X|Y) from P(Y|X) times the marginals.",
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-p05"
    }
   ],
   "recall": [
    {
     "id": "sb03-jointmarginalconditional-recap-u04-c02-r1",
     "question": "What is P(Y=1|X=0) in the SB03 table?",
     "answer": "0.2 / 0.5 = 0.4.",
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-p06"
    },
    {
     "id": "sb03-jointmarginalconditional-recap-u04-c02-r2",
     "question": "When is conditioning undefined?",
     "answer": "On an impossible event: P(Y|X=0) has no answer if P(X=0) = 0.",
     "anchor": "sb03-jointmarginalconditional-recap-u04-c02-p11"
    }
   ]
