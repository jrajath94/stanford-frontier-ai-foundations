   "keyTerms": [
    {
     "term": "Student A",
     "definition": "Contaminated the test set by tuning on it.",
     "anchor": "d05-p01"
    },
    {
     "term": "Student B",
     "definition": "Tuned on validation, tested once: trustworthy.",
     "anchor": "d05-p01"
    }
   ],
   "recall": [
    {
     "id": "d05-r1",
     "question": "D05: What is the answer?",
     "answer": "Student B. Student A contaminated the test set by tuning on it, so the score measures tuning effort, not future performance.",
     "anchor": "d05-p01"
    }
   ]
  },
