     "reveal": "rise"
    },
    {
     "anchor": "sb18-lec-16-the-bayes-classifier-p06",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "Bayes classifier",
     "definition": "Predicts argmax_k p(k|x): the smallest population risk.",
     "anchor": "sb18-lec-16-the-bayes-classifier-p04"
    },
    {
     "term": "Bayes error",
     "definition": "0.1587 here: the floor no data amount crosses.",
     "anchor": "sb18-lec-16-the-bayes-classifier-p06"
    }
   ],
   "recall": [
    {
     "id": "sb18-lec-16-the-bayes-classifier-r1",
     "question": "What is the Bayes rule for the two-Gaussian toy?",
     "answer": "Predict 1 when x > 1. Error 0.1587.",
     "anchor": "sb18-lec-16-the-bayes-classifier-p07"
    },
    {
     "id": "sb18-lec-16-the-bayes-classifier-r2",
     "question": "When is argmax posterior the wrong rule?",
     "answer": "With asymmetric costs: optimality is loss-specific.",
     "anchor": "sb18-lec-16-the-bayes-classifier-p16"
    }
   ]
  },
