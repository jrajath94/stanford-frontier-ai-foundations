  {
   "anchor": "sb17-lec-15-the-risk-minimization-framework",
   "title": "SB17, Lec 15: the risk minimization framework",
   "minutes": 3,
   "endAnchor": "sb17-lec-15-the-risk-minimization-framework-end",
   "blocks": [
    {
     "anchor": "sb17-lec-15-the-risk-minimization-framework-p05",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb17-lec-15-the-risk-minimization-framework-p07",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "risk",
     "definition": "The expected price R(h) of a rule.",
     "anchor": "sb17-lec-15-the-risk-minimization-framework-p05"
    },
    {
     "term": "ERM",
     "definition": "Picks the h in H with the smallest measured price R_hat.",
     "anchor": "sb17-lec-15-the-risk-minimization-framework-p05"
    },
    {
     "term": "hypothesis class",
     "definition": "H: the rules you allow.",
     "anchor": "sb17-lec-15-the-risk-minimization-framework-p02"
    }
   ],
   "recall": [
    {
     "id": "sb17-lec-15-the-risk-minimization-framework-r1",
     "question": "What did ERM pick on the six-point toy?",
     "answer": "h2 (t=3.5) with R_hat = 0.0, over h1 (t=2.5) with R_hat = 1/6.",
     "anchor": "sb17-lec-15-the-risk-minimization-framework-p12"
    },
    {
     "id": "sb17-lec-15-the-risk-minimization-framework-r2",
     "question": "Why is the framework's verdict correct and useless for the memorizer?",
     "answer": "R_hat = 0 but R = 0.5: the verdict is about the sample.",
     "anchor": "sb17-lec-15-the-risk-minimization-framework-p13"
    }
   ]
  },
  {
   "anchor": "sb18-lec-16-the-bayes-classifier",
   "title": "SB18, Lec 16: the Bayes classifier",
   "minutes": 3,
   "endAnchor": "sb18-lec-16-the-bayes-classifier-end",
   "blocks": [
    {
     "anchor": "sb18-lec-16-the-bayes-classifier-p04",
