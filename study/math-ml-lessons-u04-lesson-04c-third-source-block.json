  {
   "anchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc",
   "title": "SB20, Tutorials 4-6: minmax, Neyman-Pearson, and ROC",
   "minutes": 3,
   "endAnchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-end",
   "blocks": [
    {
     "anchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-p05",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-p07",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "minmax",
     "definition": "Minimize the worst of FPR and FNR: t=0.5 wins with 0.3333.",
     "anchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-p05"
    },
    {
     "term": "Neyman-Pearson",
     "definition": "Fix FPR <= alpha, maximize TPR.",
     "anchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-p07"
    },
    {
     "term": "ROC",
     "definition": "The tradeoff curve; AUC = 0.9167 here.",
     "anchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-p07"
    }
   ],
   "recall": [
    {
     "id": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-r1",
     "question": "What does Neyman-Pearson pick at alpha=0.1?",
     "answer": "t=0.5: the only candidate with FPR=0, TPR=0.6667.",
     "anchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-p08"
    },
    {
     "id": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-r2",
     "question": "Why is a training-tuned threshold optimistic?",
     "answer": "The ROC looks better than it is; deployed FPR breaks the budget.",
     "anchor": "sb20-tutorials-4-6-minmax-neyman-pearson-and-roc-p14"
    }
   ]
  },
  {
   "anchor": "sb21-lec-20-21-latent-variable-models",
   "title": "SB21, Lec 20-21: latent variable models",
   "minutes": 3,
   "endAnchor": "sb21-lec-20-21-latent-variable-models-end",
   "blocks": [
    {
     "anchor": "sb21-lec-20-21-latent-variable-models-p04",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb21-lec-20-21-latent-variable-models-p06",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "latent variable",
     "definition": "A missing column in the spreadsheet: the cluster label z.",
     "anchor": "sb21-lec-20-21-latent-variable-models-p04"
    },
    {
     "term": "incomplete likelihood",
     "definition": "prod_i sum_z p(x_i, z): the log sits outside the sum.",
     "anchor": "sb21-lec-20-21-latent-variable-models-p06"
    },
    {
     "term": "complete likelihood",
     "definition": "prod_i p(x_i, z_i): easy, but z is unobserved.",
     "anchor": "sb21-lec-20-21-latent-variable-models-p06"
    }
   ],
   "recall": [
    {
     "id": "sb21-lec-20-21-latent-variable-models-r1",
     "question": "Why does the log block direct MLE here?",
     "answer": "The log sits outside the sum over z: no closed form.",
     "anchor": "sb21-lec-20-21-latent-variable-models-p06"
    },
    {
     "id": "sb21-lec-20-21-latent-variable-models-r2",
     "question": "What is the degeneracy?",
     "answer": "sigma_1^2 -> 0 makes one point's density explode: the likelihood goes to infinity.",
     "anchor": "sb21-lec-20-21-latent-variable-models-p13"
    }
   ]
  },
  {
   "anchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence",
   "title": "SB22, Lec 22-23: the EM algorithm and its convergence",
   "minutes": 4,
   "endAnchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-end",
   "blocks": [
    {
     "anchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-p04",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-p06",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "E-step",
     "definition": "Guess the missing column softly: responsibilities r_i.",
     "anchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-p04"
    },
    {
     "term": "M-step",
     "definition": "Fit as if the guess were data: weighted averages.",
     "anchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-p04"
    },
    {
     "term": "Jensen",
     "definition": "The inequality that builds the monotone bound.",
     "anchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-p06"
    }
   ],
   "recall": [
    {
     "id": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-r1",
     "question": "What did two EM iterations do to the six points?",
     "answer": "mu went [1,4] -> [0.0026,5.0635] -> [0.0000,5.0667]; likelihood -13.0089 -> -3.4450.",
     "anchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-p09"
    },
    {
     "id": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-r2",
     "question": "Why is monotone not global?",
     "answer": "The bound touches locally. Start B converged to -14.11, far below -3.33.",
     "anchor": "sb22-lec-22-23-the-em-algorithm-and-its-convergence-p16"
    }
   ]
  },
  {
   "anchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy",
   "title": "SB23, Lec 24 and Tutorial 8: EM for GMMs, initialization, degeneracy",
   "minutes": 3,
   "endAnchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-end",
   "blocks": [
    {
     "anchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-p04",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-p06",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "initialization",
     "definition": "The start is the algorithm's fate.",
     "anchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-p04"
    },
    {
     "term": "restart",
     "definition": "The standard defense: best final likelihood of R runs.",
     "anchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-p06"
    },
    {
     "term": "degeneracy",
     "definition": "Unbounded likelihood: variance -> 0 on one point.",
     "anchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-p06"
    }
   ],
   "recall": [
    {
     "id": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-r1",
     "question": "What did the two starts find?",
     "answer": "A: mu=[0.0000,5.0667], ll=-3.3320. B: mu=[2.1213,2.9460], ll=-14.1109.",
     "anchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-p08"
    },
    {
     "id": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-r2",
     "question": "What are the practical defenses against degeneracy?",
     "answer": "A variance floor, a prior on variances, or tied variances.",
     "anchor": "sb23-lec-24-and-tutorial-8-em-for-gmms-initialization-degeneracy-p06"
    }
   ]
