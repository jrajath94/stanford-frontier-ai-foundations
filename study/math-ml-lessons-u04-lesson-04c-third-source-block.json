  {
   "anchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability",
   "title": "SB24, Lec 25 and Tutorial 9: MAP estimate and identifiability",
   "minutes": 3,
   "endAnchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-end",
   "blocks": [
    {
     "anchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-p05",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-p07",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "MAP",
     "definition": "MLE plus prior: (7+1)/(10+2) = 0.6667 for Beta(2,2).",
     "anchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-p05"
    },
    {
     "term": "identifiability",
     "definition": "Whether the data can separate two parameter values.",
     "anchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-p07"
    },
    {
     "term": "label switching",
     "definition": "Permuting component labels leaves the mixture unchanged.",
     "anchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-p07"
    }
   ],
   "recall": [
    {
     "id": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-r1",
     "question": "Show the swap test.",
     "answer": "loglik at mu=[0,5] is -9.8125; at mu=[5,0] it is -9.8125 again.",
     "anchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-p13"
    },
    {
     "id": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-r2",
     "question": "Why is the MCMC posterior mean of mu_1 = 2.5 meaningless?",
     "answer": "Label switching: the chain wanders between K! modes; 2.5 is the midpoint, neither component.",
     "anchor": "sb24-lec-25-and-tutorial-9-map-estimate-and-identifiability-p15"
    }
   ]
  },
