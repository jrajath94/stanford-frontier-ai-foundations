     "definition": "The true priors and class densities are known.",
     "anchor": "e01-p01"
    }
   ],
   "recall": [
    {
     "id": "e01-r1",
     "question": "State the Bayes decision rule for 0-1 loss.",
     "answer": "Predict argmax_k p(k|x).",
     "anchor": "e01-p01"
    }
   ]
  },
  {
   "anchor": "e02",
   "title": "E02",
   "minutes": 1,
   "endAnchor": "e02-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "boundary",
     "definition": "x = 1: where (x-2)^2 = x^2.",
     "anchor": "e02-p01"
    },
    {
     "term": "Bayes error",
     "definition": "1 - Phi(1) = 0.1587.",
     "anchor": "e02-p01"
    }
   ],
   "recall": [
    {
     "id": "e02-r1",
     "question": "Compute the Bayes error for the two-Gaussian toy.",
     "answer": "0.1587, at boundary x = 1.",
     "anchor": "e02-p01"
    }
   ]
  },
  {
   "anchor": "e03",
   "title": "E03",
   "minutes": 1,
   "endAnchor": "e03-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "threshold 1.5",
     "definition": "Error 0.1877: off-center costs 0.0290.",
     "anchor": "e03-p01"
    },
    {
     "term": "excess error",
     "definition": "0.1877 - 0.1587 = 0.0290 for threshold 1.5.",
     "anchor": "e03-p01"
    }
   ],
   "recall": [
    {
     "id": "e03-r1",
     "question": "What does threshold x=1.5 cost?",
     "answer": "Error 0.1877, excess 0.0290 over Bayes.",
     "anchor": "e03-p01"
    }
   ]
  },
  {
   "anchor": "e04",
   "title": "E04",
   "minutes": 1,
   "endAnchor": "e04-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "posterior odds",
     "definition": "Compare to the cost ratio, not to 1.",
     "anchor": "e04-p01"
    },
    {
     "term": "cost ratio",
     "definition": "Predict 1 when posterior odds exceed c_FP/c_FN = 0.1.",
     "anchor": "e04-p01"
    }
   ],
   "recall": [
    {
     "id": "e04-r1",
     "question": "Is argmax posterior optimal with 10x false-negative cost?",
     "answer": "No. The threshold moves toward predicting the costly class more often.",
     "anchor": "e04-p01"
    }
   ]
  },
  {
   "anchor": "e05",
   "title": "E05",
   "minutes": 1,
   "endAnchor": "e05-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "Neyman-Pearson",
     "definition": "t = 0.5: only threshold with FPR = 0 <= 0.1.",
     "anchor": "e05-p01"
    },
    {
     "term": "TPR",
     "definition": "2/3 = 0.6667 at t = 0.5.",
     "anchor": "e05-p01"
    }
   ],
   "recall": [
    {
     "id": "e05-r1",
     "question": "Which threshold does NP pick at alpha=0.1?",
     "answer": "t = 0.5, achieving TPR 0.6667.",
     "anchor": "e05-p01"
    }
   ]
  },
  {
   "anchor": "e06",
   "title": "E06",
   "minutes": 1,
   "endAnchor": "e06-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "AUC",
     "definition": "0.9167 by the trapezoid rule.",
     "anchor": "e06-p01"
    },
    {
     "term": "trapezoid",
     "definition": "Width times mean height per segment.",
     "anchor": "e06-p01"
    }
   ],
   "recall": [
    {
     "id": "e06-r1",
     "question": "Show the AUC terms.",
     "answer": "(0,2/3)->(0.5,1): 0.5 * 5/6 = 0.4167. (0.5,1)->(1,1): 0.5. Total 0.9167.",
     "anchor": "e06-p01"
    }
   ]
  },
  {
   "anchor": "e07",
   "title": "E07",
   "minutes": 1,
   "endAnchor": "e07-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "optimistic",
     "definition": "FPR = 0 on 2 negatives means no false alarm yet.",
     "anchor": "e07-p01"
    },
    {
     "term": "noisy",
     "definition": "Small samples make every ROC point noisy.",
     "anchor": "e07-p01"
    }
   ],
   "recall": [
    {
     "id": "e07-r1",
     "question": "Why is a training-tuned threshold optimistic?",
     "answer": "The threshold adapts to the training scores' noise.",
     "anchor": "e07-p01"
    }
   ]
  },
  {
   "anchor": "e08",
   "title": "E08",
   "minutes": 1,
   "endAnchor": "e08-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "miss",
     "definition": "Costs more than 1.5x a false alarm here.",
     "anchor": "e08-p01"
    },
    {
     "term": "expected cost",
     "definition": "c_FP * FPR + c_FN * FNR.",
     "anchor": "e08-p01"
    }
   ],
   "recall": [
    {
     "id": "e08-r1",
     "question": "When does t=0.3 beat t=0.5?",
     "answer": "When a miss costs more than 1.5x a false alarm, e.g. c_FP=1, c_FN=10.",
     "anchor": "e08-p01"
    }
   ]
  },
  {
   "anchor": "e09",
   "title": "E09",
   "minutes": 1,
   "endAnchor": "e09-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "incomplete likelihood",
     "definition": "prod_i [0.5 N(x_i,mu_1) + 0.5 N(x_i,mu_2)].",
     "anchor": "e09-p01"
    },
    {
     "term": "block",
     "definition": "d/dmu of log(a+b) does not split.",
     "anchor": "e09-p01"
    }
   ],
   "recall": [
    {
     "id": "e09-r1",
     "question": "Why does the log block direct maximization?",
     "answer": "The sum sits inside the log: term-by-term differentiation fails.",
     "anchor": "e09-p01"
    }
   ]
  },
  {
