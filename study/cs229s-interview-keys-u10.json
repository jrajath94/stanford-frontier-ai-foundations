        },
        {
          "term": "measured grade",
          "definition": "What a sound table promotes a claim to.",
          "anchor": "analytical-answers-p01"
        },
        {
          "term": "RRF scores",
          "definition": "D 0.031258, E 0.022643.",
          "anchor": "analytical-answers-p01"
        }
      ],
      "recall": [
        {
          "id": "analytical-answers-r1",
          "question": "Fusion: doc D ranks (3, 5), doc E ranks (1, 100), k=60. Compute both RRF scores. Why does D win?",
          "answer": "D: 0.031258. E: 0.022643. Fusion rewards agreement across systems over one loud rank.",
          "anchor": "analytical-answers-p01"
        },
        {
          "id": "analytical-answers-r2",
          "question": "Grade: “2x faster” (no table), “O(T d^2)” (derivable), “SSMs are the future”. A sound table appears for the first: new grade?",
          "answer": "Stated, derived, opinion. With a sound table: measured. Still check baselines, seeds, metric.",
          "anchor": "analytical-answers-p02"
        }
      ],
