          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "amortization",
          "definition": "B/N + q.",
          "anchor": "breadth-answers-p01"
        },
        {
          "term": "RRF",
          "definition": "sum 1/(k+rank).",
          "anchor": "breadth-answers-p01"
        },
        {
          "term": "evidence grades",
          "definition": "measured, derived, stated, opinion.",
          "anchor": "breadth-answers-p01"
        },
        {
          "term": "quality gate",
          "definition": "Ship iff delta >= -epsilon.",
          "anchor": "breadth-answers-p01"
        }
      ],
      "recall": [
        {
          "id": "breadth-answers-r1",
          "question": "Write the index amortization formula. When does brute force win?",
          "answer": "Amortized = B/N + q. Brute force wins below break-even N.",
          "anchor": "breadth-answers-p01"
        },
        {
          "id": "breadth-answers-r2",
          "question": "Write the RRF formula. Why do ranks beat raw scores?",
          "answer": "RRF = sum 1/(k+rank). Ranks need no calibration across systems.",
          "anchor": "breadth-answers-p04"
        },
        {
          "id": "breadth-answers-r3",
          "question": "Write the quality-gate rule.",
          "answer": "Ship iff delta >= -epsilon on the task metric.",
          "anchor": "breadth-answers-p08"
        }
      ],
      "minutes": 3
    },
    {
      "anchor": "deep-ladder-1-answers",
      "title": "Deep ladder 1 answers",
      "endAnchor": "deep-ladder-1-answers-end",
      "blocks": [
