          "anchor": "deep-ladder-1-answers-p02",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "build vs query",
          "definition": "One-time cost vs marginal cost.",
          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "term": "break-even N",
          "definition": "160,000 on the toy.",
          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "term": "static-index assumption",
          "definition": "Hourly rebuilds reset amortization.",
          "anchor": "deep-ladder-1-answers-p02"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-1-answers-r1",
          "question": "Build 7200 s, query 5 ms, brute 50 ms. Amortized cost at 1M queries and break-even N?",
          "answer": "12.2 ms at 1M. Break-even 160,000 queries.",
          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "id": "deep-ladder-1-answers-r2",
          "question": "The index never pays off. Name the cause.",
          "answer": "Query volume below break-even.",
          "anchor": "deep-ladder-1-answers-p06"
        }
      ],
      "minutes": 2
    },
    {
      "anchor": "deep-ladder-2-answers",
      "title": "Deep ladder 2 answers",
      "endAnchor": "deep-ladder-2-answers-end",
      "blocks": [
        {
          "anchor": "deep-ladder-2-answers-p02",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "cascade",
          "definition": "ANN, filter, cross-encoder rerank.",
          "anchor": "deep-ladder-2-answers-p02"
        },
        {
          "term": "dominant stage",
          "definition": "The reranker: 400/405 of cost.",
          "anchor": "deep-ladder-2-answers-p02"
        },
        {
          "term": "funnel-keeps-gold",
          "definition": "A recall miss starves the reranker.",
          "anchor": "deep-ladder-2-answers-p02"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-2-answers-r1",
          "question": "ANN 5 ms, rerank 20 docs at 20 ms. Compute the cascade cost.",
          "answer": "5 + 400 = 405 ms.",
          "anchor": "deep-ladder-2-answers-p02"
        },
        {
          "id": "deep-ladder-2-answers-r2",
          "question": "Quality drops though the reranker is great. Name the failure point.",
          "answer": "The ANN's top-k missed the gold doc. The funnel, not the reranker, failed.",
          "anchor": "deep-ladder-2-answers-p06"
        }
      ],
      "minutes": 2
    },
