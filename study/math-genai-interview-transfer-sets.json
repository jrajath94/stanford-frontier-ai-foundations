   "blocks": [],
   "keyTerms": [
    {
     "term": "P’ = [0.625, 0.375, 0]",
     "definition": "The changed data.",
     "anchor": "t-u01-generative-modeling-basics-p01"
    },
    {
     "term": "future tail",
     "definition": "The all-heads MLE assigns it log-likelihood log 0 = -inf.",
     "anchor": "t-u01-generative-modeling-basics-p02"
    }
   ],
   "recall": [
    {
     "id": "t-u01-generative-modeling-basics-r1",
     "question": "What does KL(Q || P') teach?",
     "answer": "The support rule: KL is finite only where the first argument's support sits inside the second's.",
     "anchor": "t-u01-generative-modeling-basics-p01"
    },
    {
     "id": "t-u01-generative-modeling-basics-r2",
     "question": "What is the standard fix for the all-heads MLE?",
     "answer": "Laplace smoothing.",
     "anchor": "t-u01-generative-modeling-basics-p02"
    }
   ]
  },
  {
   "anchor": "t-u02-variational-divergence-minimization",
   "title": "T-U02, variational divergence minimization",
   "minutes": 1,
   "endAnchor": "t-u02-variational-divergence-minimization-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "{1, 3}",
     "definition": "The shifted values.",
     "anchor": "t-u02-variational-divergence-minimization-p01"
    },
    {
     "term": "0.5",
     "definition": "The D* crossing threshold.",
     "anchor": "t-u02-variational-divergence-minimization-p02"
    }
   ],
   "recall": [
    {
     "id": "t-u02-variational-divergence-minimization-r1",
     "question": "Which quantity stayed fixed, and why?",
     "answer": "The Jensen gap: for f(x) = x^2 it is the variance, translation-invariant.",
     "anchor": "t-u02-variational-divergence-minimization-p01"
    },
    {
     "id": "t-u02-variational-divergence-minimization-r2",
     "question": "Which outcomes cross 0.5?",
     "answer": "Outcome 1 crosses above to below; outcome 2 below to above; outcome 3 lands on 0.5.",
     "anchor": "t-u02-variational-divergence-minimization-p02"
    }
   ]
  },
  {
   "anchor": "t-u03-gan-foundations",
   "title": "T-U03, GAN foundations",
   "minutes": 1,
   "endAnchor": "t-u03-gan-foundations-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "Q’ = [1, 0, 0]",
     "definition": "The collapsed generator.",
     "anchor": "t-u03-gan-foundations-p01"
    },
    {
     "term": "stale",
     "definition": "The discriminator that rewards collapse.",
     "anchor": "t-u03-gan-foundations-p01"
    }
   ],
   "recall": [
    {
     "id": "t-u03-gan-foundations-r1",
     "question": "What is the lesson about stale discriminators?",
     "answer": "Evaluate a generator only against a current discriminator; a stale D is a broken metric.",
     "anchor": "t-u03-gan-foundations-p01"
    },
    {
     "id": "t-u03-gan-foundations-r2",
     "question": "Where does the mass go under an optimal discriminator?",
     "answer": "To outcome 1, the mode of P: sample diversity suffers.",
     "anchor": "t-u03-gan-foundations-p02"
    }
   ]
  },
