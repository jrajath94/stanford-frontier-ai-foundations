   "keyTerms": [
    {
     "term": "multivariate Gaussian",
     "definition": "A bell with an arrow shape: mean says where, covariance says how stretched.",
     "anchor": "sb15-multivariate-gaussian-and-its-mle-lec-17-extension-c05-p03"
    },
    {
     "term": "MLE",
     "definition": "mu_hat = coordinate mean; Sigma_hat = average outer product of centered points.",
     "anchor": "sb15-multivariate-gaussian-and-its-mle-lec-17-extension-c05-p05"
    },
    {
     "term": "PSD",
     "definition": "Sigma_hat eigenvalues positive: the bell is real.",
     "anchor": "sb15-multivariate-gaussian-and-its-mle-lec-17-extension-c05-p08"
    }
   ],
   "recall": [
    {
     "id": "sb15-multivariate-gaussian-and-its-mle-lec-17-extension-c05-r1",
     "question": "What did the six-point cloud give?",
     "answer": "mu_hat = [0.0833, 0.1], Sigma_hat = [[0.0847,0.005],[0.005,0.1]], eigenvalues [0.0832, 0.1015].",
     "anchor": "sb15-multivariate-gaussian-and-its-mle-lec-17-extension-c05-p06"
    },
    {
     "id": "sb15-multivariate-gaussian-and-its-mle-lec-17-extension-c05-r2",
     "question": "When does the Gaussian MLE break?",
     "answer": "n < d: Sigma_hat is singular. Fix: shrinkage or a diagonal assumption.",
     "anchor": "sb15-multivariate-gaussian-and-its-mle-lec-17-extension-c05-p12"
    }
   ]
