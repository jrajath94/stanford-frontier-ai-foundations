  {
   "anchor": "sb09-entropy-lec-11",
   "title": "SB09, entropy (Lec 11)",
   "minutes": 2,
   "endAnchor": "sb09-entropy-lec-11-end",
   "blocks": [
    {
     "anchor": "sb09-entropy-lec-11-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb09-entropy-lec-11-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "entropy",
     "definition": "The fog meter: average surprise H(p) = -sum p(x) log p(x).",
     "anchor": "sb09-entropy-lec-11-p03"
    },
    {
     "term": "nats",
     "definition": "Entropy units with base-e logs; divide by log 2 for bits.",
     "anchor": "sb09-entropy-lec-11-p04"
    },
    {
     "term": "Gini",
     "definition": "1 - sum p^2: the same fog with cheaper arithmetic.",
     "anchor": "sb09-entropy-lec-11-p12"
    }
   ],
   "recall": [
    {
     "id": "sb09-entropy-lec-11-r1",
     "question": "What is the entropy of a fair coin?",
     "answer": "0.6931 nats = 1 bit, the maximum for 2 outcomes.",
     "anchor": "sb09-entropy-lec-11-p06"
    },
    {
     "id": "sb09-entropy-lec-11-r2",
     "question": "Why can continuous entropy be negative?",
     "answer": "A sharp spike has differential entropy below zero; the fog-meter intuition needs the discrete form.",
     "anchor": "sb09-entropy-lec-11-p13"
    }
   ]
  },
  {
   "anchor": "sb10-kl-divergence-lec-12",
   "title": "SB10, KL divergence (Lec 12)",
   "minutes": 3,
   "endAnchor": "sb10-kl-divergence-lec-12-end",
   "blocks": [
    {
     "anchor": "sb10-kl-divergence-lec-12-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb10-kl-divergence-lec-12-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "KL divergence",
     "definition": "The toll for the wrong map: D_KL(p||q) = sum p log(p/q).",
     "anchor": "sb10-kl-divergence-lec-12-p03"
    },
    {
     "term": "asymmetric",
     "definition": "D_KL(p||q) = 0.0823 but D_KL(q||p) = 0.0872: not a distance.",
     "anchor": "sb10-kl-divergence-lec-12-p05"
    },
    {
     "term": "cross-entropy",
     "definition": "H(p) + D_KL(p||q): truth-entropy plus the toll.",
     "anchor": "sb10-kl-divergence-lec-12-p06"
    }
   ],
   "recall": [
    {
     "id": "sb10-kl-divergence-lec-12-r1",
     "question": "What is the price of believing q=[0.5,0.5] when truth is p=[0.7,0.3]?",
     "answer": "0.0823 nats.",
     "anchor": "sb10-kl-divergence-lec-12-p06"
    },
    {
     "id": "sb10-kl-divergence-lec-12-r2",
     "question": "What happens when q assigns zero where p is positive?",
     "answer": "The toll is infinite: the model calls an observed event impossible.",
     "anchor": "sb10-kl-divergence-lec-12-p12"
    }
   ]
  },
  {
   "anchor": "sb11-minimization-of-kl-divergence-lec-13",
   "title": "SB11, minimization of KL divergence (Lec 13)",
   "minutes": 3,
   "endAnchor": "sb11-minimization-of-kl-divergence-lec-13-end",
   "blocks": [
    {
     "anchor": "sb11-minimization-of-kl-divergence-lec-13-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "sb11-minimization-of-kl-divergence-lec-13-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    },
    {
     "anchor": "sb11-minimization-of-kl-divergence-lec-13-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "KL minimization",
     "definition": "Tunes the map until the toll vanishes at the truth.",
     "anchor": "sb11-minimization-of-kl-divergence-lec-13-p03"
    },
    {
     "term": "misspecified",
     "definition": "The family cannot reach the truth; the toll never hits zero.",
     "anchor": "sb11-minimization-of-kl-divergence-lec-13-p12"
    }
   ],
   "recall": [
    {
     "id": "sb11-minimization-of-kl-divergence-lec-13-r1",
     "question": "Which q minimizes D_KL(p||q) for p=[0.7,0.3], q=[t,1-t]?",
     "answer": "t = 0.7, with D_KL = 0.0. The best model is the truth itself.",
     "anchor": "sb11-minimization-of-kl-divergence-lec-13-p06"
    },
    {
     "id": "sb11-minimization-of-kl-divergence-lec-13-r2",
     "question": "Why does a 'converged' report mislead for a fixed q=[0.5,0.5]?",
     "answer": "The minimum toll is 0.0823, not 0: the model stays wrong.",
     "anchor": "sb11-minimization-of-kl-divergence-lec-13-p12"
    }
   ]
  },
