    }
   ],
   "keyTerms": [
    {
     "term": "Gaussian MLE",
     "definition": "Two averages: center = mean, width = mean squared spread.",
     "anchor": "sb13-mle-for-the-gaussian-lec-17-tutorial-7a-p03"
    },
    {
     "term": "unbiased variance",
     "definition": "Divides by n-1 (0.0667) instead of n.",
     "anchor": "sb13-mle-for-the-gaussian-lec-17-tutorial-7a-p11"
    }
   ],
   "recall": [
    {
     "id": "sb13-mle-for-the-gaussian-lec-17-tutorial-7a-r1",
     "question": "What is the Gaussian MLE for [2.1, 2.5, 1.9, 2.3]?",
     "answer": "mu_hat = 2.2, sigma2_hat = 0.05.",
     "anchor": "sb13-mle-for-the-gaussian-lec-17-tutorial-7a-p06"
    },
    {
     "id": "sb13-mle-for-the-gaussian-lec-17-tutorial-7a-r2",
     "question": "What does one outlier do to the Gaussian MLE?",
     "answer": "A fifth point at 20 moves mu_hat to 5.76: no defense against contamination.",
     "anchor": "sb13-mle-for-the-gaussian-lec-17-tutorial-7a-p12"
    }
   ]
  },
