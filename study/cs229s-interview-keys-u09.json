      ],
      "recall": [
        {
          "id": "breadth-answers-r1",
          "question": "Write the ring all-reduce formula. Name the two passes.",
          "answer": "T = 2*(n-1)/n * S/BW. Reduce-scatter then all-gather.",
          "anchor": "breadth-answers-p02"
        },
        {
          "id": "breadth-answers-r2",
          "question": "Write the pipeline bubble formula.",
          "answer": "Bubble = (p-1)/(m+p-1).",
          "anchor": "breadth-answers-p05"
        },
        {
          "id": "breadth-answers-r3",
          "question": "Write the cluster MTBF formula.",
          "answer": "Cluster MTBF = per-GPU MTBF / GPU count.",
          "anchor": "breadth-answers-p08"
        }
      ],
      "minutes": 3
