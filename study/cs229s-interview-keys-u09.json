          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "id": "deep-ladder-1-answers-r2",
          "question": "Sync takes 3x the formula. Name two causes.",
          "answer": "Incast congestion, or a degraded link throttling the ring.",
