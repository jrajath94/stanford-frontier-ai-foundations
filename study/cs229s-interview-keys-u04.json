    },
    {
      "anchor": "b1",
      "title": "B1",
      "endAnchor": "b1-end",
      "blocks": [
        {
          "anchor": "b1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "warp",
          "definition": "32 lockstep threads.",
          "anchor": "b1-p01"
        },
        {
          "term": "divergence",
          "definition": "The cost of threads going different ways.",
          "anchor": "b1-p01"
        }
      ],
      "recall": [
        {
          "id": "b1-r1",
          "question": "B1. Define warp, block, grid. How many warps in a 256-thread block?",
          "answer": "Warp: 32 lockstep threads. Block: on one SM. Grid: all blocks. 256/32 = 8 warps.",
          "anchor": "b1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b2",
      "title": "B2",
      "endAnchor": "b2-end",
      "blocks": [
        {
          "anchor": "b2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "coalescing",
          "definition": "Stride-1 reads merge into one transaction.",
          "anchor": "b2-p01"
        },
        {
          "term": "32x waste",
          "definition": "What stride-32 costs.",
          "anchor": "b2-p01"
        }
      ],
      "recall": [
        {
          "id": "b2-r1",
          "question": "B2. 32 threads read fp32 with stride 32. How many 128-byte transactions? What about stride 1?",
          "answer": "Stride 32: 32 transactions. Stride 1: 1. The waste is 32x.",
          "anchor": "b2-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b3",
      "title": "B3",
      "endAnchor": "b3-end",
      "blocks": [
        {
          "anchor": "b3-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "tiling",
          "definition": "Blocking the working set for on-chip reuse.",
          "anchor": "b3-p01"
        },
        {
          "term": "k-loop",
          "definition": "The tiled axis.",
          "anchor": "b3-p01"
        }
      ],
      "recall": [
        {
          "id": "b3-r1",
          "question": "B3. Define tiling. For a (1024,1024,1024) matmul with 64-wide tiles, how many times is each A element read from HBM vs naive?",
          "answer": "Tiling blocks the working set for on-chip reuse. Naive: 1024 reads per A element. Tiled: 16.",
          "anchor": "b3-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b4",
      "title": "B4",
      "endAnchor": "b4-end",
      "blocks": [
        {
          "anchor": "b4-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "barrier",
          "definition": "All threads arrive before any proceeds.",
          "anchor": "b4-p01"
        },
        {
          "term": "divergent barrier",
          "definition": "The deadlock mistake.",
          "anchor": "b4-p01"
        }
      ],
      "recall": [
        {
          "id": "b4-r1",
          "question": "B4. What does __syncthreads guarantee? Name the deadlock mistake.",
          "answer": "All block threads arrive before any proceeds. Deadlock: barrier inside divergent control flow.",
          "anchor": "b4-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b5",
      "title": "B5",
      "endAnchor": "b5-end",
      "blocks": [
        {
          "anchor": "b5-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "occupancy",
          "definition": "Active over max warps.",
          "anchor": "b5-p01"
        },
        {
          "term": "shared limiter",
          "definition": "48 KB blocks: 2 per SM.",
          "anchor": "b5-p01"
        }
      ],
      "recall": [
        {
          "id": "b5-r1",
          "question": "B5. Define occupancy. A 256-thread block uses 48 KB shared per SM-budget 100 KB: what is the occupancy at 64 max warps?",
          "answer": "Active/max warps. 2 blocks per SM = 16 warps = 25%. Shared memory limits.",
          "anchor": "b5-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b6",
