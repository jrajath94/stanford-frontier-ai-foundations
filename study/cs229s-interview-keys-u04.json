      "endAnchor": "b6-end",
      "blocks": [
        {
          "anchor": "b6-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "running max",
          "definition": "m: max of the row seen so far.",
          "anchor": "b6-p01"
        },
        {
          "term": "rescale",
          "definition": "Old sums renormalize to the new max.",
          "anchor": "b6-p01"
        }
      ],
      "recall": [
        {
          "id": "b6-r1",
          "question": "B6. Write the online softmax (m, l) update for a new block.",
          "answer": "m' = max(m, m_b), l' = l exp(m-m') + l_b exp(m_b-m').",
          "anchor": "b6-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b7",
