    {
      "anchor": "deep-ladder-1",
      "title": "Deep ladder 1",
      "endAnchor": "deep-ladder-1-end",
      "blocks": [
        {
          "anchor": "deep-ladder-1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "running max m",
          "definition": "Max of the row seen so far.",
          "anchor": "deep-ladder-1-p01"
        },
        {
          "term": "normalizer l",
          "definition": "Running sum of exp(x-m).",
          "anchor": "deep-ladder-1-p01"
        },
        {
          "term": "merge identity",
          "definition": "Proved by induction over blocks.",
          "anchor": "deep-ladder-1-p01"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-1-r1",
          "question": "Deep ladder 1: online softmax. Define m and l, run the toy blocks [1,2] then [3,100], prove the merge formula.",
          "answer": "m: running row max. l: running sum of exp(x-m). After [1,2]: m=2, l=1.368. After [3,100]: m=100, l~1.0. Merge: true normalizer = sum over blocks of l_b*exp(m_b-m').",
          "anchor": "deep-ladder-1-p01"
        }
      ],
      "minutes": 3
    },
