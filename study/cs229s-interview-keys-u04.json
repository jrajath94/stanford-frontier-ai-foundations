          "term": "recompute",
          "definition": "Score tiles rebuilt from Q, K.",
          "anchor": "b8-p01"
        }
      ],
      "recall": [
        {
          "id": "b8-r1",
          "question": "B8. In the FlashAttention backward pass, what is stored in the forward and what is recomputed?",
          "answer": "Forward stores (m, l), O(T). Backward recomputes score tiles from Q, K.",
          "anchor": "b8-p01"
        }
      ],
