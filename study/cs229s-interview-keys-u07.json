          "term": "FLOPs vs expressivity",
          "definition": "The choice with infinite SRAM.",
          "anchor": "changed-constraint-answers-p01"
        },
        {
          "term": "offline scoring",
          "definition": "Causality relaxes.",
          "anchor": "changed-constraint-answers-p01"
        },
        {
          "term": "cheapest accurate",
          "definition": "Bidirectional encoder or chunked attention.",
          "anchor": "changed-constraint-answers-p01"
        }
      ],
      "recall": [
        {
          "id": "changed-constraint-answers-r1",
          "question": "SRAM is infinite. Does the SSM still beat attention?",
          "answer": "Traffic argument dies but FLOPs do not: T^2 d vs T d^2. Choice becomes FLOPs-vs-expressivity.",
          "anchor": "changed-constraint-answers-p01"
        },
        {
          "id": "changed-constraint-answers-r2",
          "question": "The task is offline scoring of fixed documents. What relaxes, and what is cheapest?",
          "answer": "Causality relaxes: bidirectional legal. Cheapest accurate: bidirectional encoder or chunked attention.",
          "anchor": "changed-constraint-answers-p02"
        }
      ],
