          "term": "circular convolution",
          "definition": "The bug: raw FFT product.",
          "anchor": "debug-answer-p01"
        },
        {
          "term": "padding requirement",
          "definition": "Zero-pad both to 2n.",
          "anchor": "debug-answer-p01"
        }
      ],
      "recall": [
        {
          "id": "debug-answer-r1",
          "question": "The FFT convolution disagrees with the naive result. Find the bug, fix it, state the padding requirement.",
          "answer": "Bug: raw FFT product is the circular convolution. Fix: zero-pad both to 2n. The theorem needs linear convolution.",
          "anchor": "debug-answer-p01"
        }
      ],
