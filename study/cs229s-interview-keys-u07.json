    {
      "anchor": "breadth-answers",
      "title": "Breadth answers",
      "endAnchor": "breadth-answers-end",
      "blocks": [
        {
          "anchor": "breadth-answers-p02",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "quadratic attention",
          "definition": "2T^2 d FLOPs; doubling T is 4x.",
          "anchor": "breadth-answers-p02"
        },
        {
          "term": "SSM",
          "definition": "h_t = A h_{t-1} + B x_t; A controls decay.",
          "anchor": "breadth-answers-p02"
        },
        {
          "term": "scan",
          "definition": "Associative combine: O(n) work, O(log n) depth.",
          "anchor": "breadth-answers-p02"
        },
        {
          "term": "stability",
          "definition": "A^n; keep eigenvalues in the unit disk.",
          "anchor": "breadth-answers-p02"
        }
      ],
      "recall": [
        {
          "id": "breadth-answers-r1",
          "question": "Write the quadratic attention FLOP and memory formulas. What happens when T doubles?",
          "answer": "2T^2 d FLOPs per matmul, T^2 floats of scores. Doubling T multiplies both by 4.",
          "anchor": "breadth-answers-p02"
        },
        {
          "id": "breadth-answers-r2",
          "question": "Write the SSM recurrence with shapes. What does A control?",
          "answer": "h_t = A h_{t-1} + B x_t, y_t = C h_t. A: (N,N) controls memory decay and stability.",
          "anchor": "breadth-answers-p04"
        },
        {
          "id": "breadth-answers-r3",
          "question": "Write the stability growth formula. What parameterization keeps A stable?",
          "answer": "Growth A^n. Keep A stable via exp discretization of a negative continuous A, or eigenvalues inside the unit disk.",
          "anchor": "breadth-answers-p08"
        }
      ],
      "minutes": 4
    },
    {
      "anchor": "deep-ladder-1-answers",
      "title": "Deep ladder 1 answers",
      "endAnchor": "deep-ladder-1-answers-end",
      "blocks": [
        {
          "anchor": "deep-ladder-1-answers-p02",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "4x law",
          "definition": "(2T)^2 = 4T^2.",
          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "term": "linear regroup",
          "definition": "phi(Q)(phi(K)^T V): O(T d^2), O(d^2) state.",
          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "term": "sharp selection",
          "definition": "What the kernel approximation breaks on.",
          "anchor": "deep-ladder-1-answers-p02"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-1-answers-r1",
          "question": "T=8192, d=128, one head. Compute score FLOPs and score memory.",
          "answer": "Scores: 17.2 TFLOPs. Score memory: 256 MiB per head fp32.",
          "anchor": "deep-ladder-1-answers-p02"
        },
        {
          "id": "deep-ladder-1-answers-r2",
          "question": "Copy accuracy collapses under linear attention. Name the cause and the first fix.",
          "answer": "The kernel is too flat for sharp selection. First fix: try a sharper phi, or admit the task needs softmax.",
          "anchor": "deep-ladder-1-answers-p06"
        }
      ],
      "minutes": 3
    },
    {
      "anchor": "deep-ladder-2-answers",
      "title": "Deep ladder 2 answers",
      "endAnchor": "deep-ladder-2-answers-end",
      "blocks": [
        {
          "anchor": "deep-ladder-2-answers-p02",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "triple identity",
          "definition": "Recurrence, convolution view, scan: one output.",
          "anchor": "deep-ladder-2-answers-p02"
        },
        {
          "term": "impulse response",
          "definition": "Kernel taps K_k = C A^k B.",
          "anchor": "deep-ladder-2-answers-p02"
        },
        {
          "term": "selective SSM",
          "definition": "Input-dependent A: no kernel exists; scan wins.",
          "anchor": "deep-ladder-2-answers-p02"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-2-answers-r1",
          "question": "A=0.9, B=C=1, x=[1,0,1,0]. Compute the states, the kernel, and the outputs.",
          "answer": "States [1.0, 0.9, 1.81, 1.629]. Kernel [1, 0.9, 0.81, 0.729]. Outputs equal the states (C=1).",
          "anchor": "deep-ladder-2-answers-p02"
        },
        {
          "id": "deep-ladder-2-answers-r2",
          "question": "The tree total disagrees with the loop. Name the failed property.",
          "answer": "Associativity failed. The tree order then matters and the total is wrong.",
          "anchor": "deep-ladder-2-answers-p06"
        }
      ],
      "minutes": 2
    },
    {
      "anchor": "analytical-answers",
      "title": "Analytical answers",
      "endAnchor": "analytical-answers-end",
      "blocks": [
        {
          "anchor": "analytical-answers-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "fp16 max",
          "definition": "65,504: crossed at n=1115.",
          "anchor": "analytical-answers-p01"
        },
        {
          "term": "state ratio",
          "definition": "SSM state 64x smaller than scores.",
          "anchor": "analytical-answers-p01"
        },
        {
          "term": "eager loop",
          "definition": "Materializing every state destroys the advantage.",
          "anchor": "analytical-answers-p01"
        }
      ],
      "recall": [
        {
          "id": "analytical-answers-r1",
          "question": "Stability: A=0.99 vs A=1.01 over 1000 steps. When does 1.01 cross fp16 max (65,504)?",
          "answer": "0.99^1000 = 4.32e-5. 1.01^1000 = 20,959. First crossing at n = 1115.",
          "anchor": "analytical-answers-p01"
        },
        {
          "id": "analytical-answers-r2",
          "question": "T=8192, d=128: attention score bytes vs an SSM with N=64 fp32 state. What destroys the SSM advantage?",
          "answer": "Scores 134,217,728 bytes; SSM stream 2,097,152; state 32,768: 64x. An unfused eager loop destroys it.",
          "anchor": "analytical-answers-p02"
        }
      ],
      "minutes": 2
    },
