  "sections": [
    {
      "anchor": "cs229s-interview-keys-u03-intro",
      "title": "Interview answer keys, U03",
      "endAnchor": "cs229s-interview-keys-u03-intro-end",
      "blocks": [],
      "keyTerms": [
        {
          "term": "answer key",
          "definition": "Minimum sufficient explanation, strong answer, red flags, rubric, remediation per item.",
          "anchor": "cs229s-interview-keys-u03-intro-p02"
        },
        {
          "term": "remediation",
          "definition": "The lesson concept to revisit, e.g. C01 toy.",
          "anchor": "cs229s-interview-keys-u03-intro-p02"
        }
      ],
      "recall": [
        {
          "id": "cs229s-interview-keys-u03-intro-r1",
          "question": "What does each answer in this key contain?",
          "answer": "The minimum sufficient explanation, a strong answer, red flags, a rubric, and remediation.",
          "anchor": "cs229s-interview-keys-u03-intro-p02"
        }
      ],
      "minutes": 4
    },
    {
      "anchor": "b1",
      "title": "B1",
      "endAnchor": "b1-end",
      "blocks": [
        {
          "anchor": "b1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "attention term",
          "definition": "12LnTD: dominates past T ~ 6n.",
          "anchor": "b1-p01"
        },
        {
          "term": "6PD",
          "definition": "The dense training term.",
          "anchor": "b1-p01"
        }
      ],
      "recall": [
        {
          "id": "b1-r1",
          "question": "B1. Write the full training FLOP formula with the attention term. When does the attention term dominate?",
          "answer": "C = 6PD + 12LnTD. Attention dominates past T ~ 6n.",
          "anchor": "b1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b2",
      "title": "B2",
      "endAnchor": "b2-end",
      "blocks": [
        {
          "anchor": "b2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "decode FLOPs",
          "definition": "2P + 4LTn per token.",
          "anchor": "b2-p01"
        },
        {
          "term": "intensity ~1",
          "definition": "Each weight read once per token: bandwidth binds.",
          "anchor": "b2-p01"
        }
      ],
      "recall": [
        {
          "id": "b2-r1",
          "question": "B2. State per-token decode FLOPs. Why is decode bandwidth-bound at batch 1 despite low FLOPs?",
          "answer": "2P + 4LTn per token. Bandwidth-bound because each weight is read once per token (intensity ~1).",
          "anchor": "b2-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b3",
      "title": "B3",
      "endAnchor": "b3-end",
      "blocks": [
        {
          "anchor": "b3-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "KV bytes",
          "definition": "2*B*T*L*n*2.",
          "anchor": "b3-p01"
        },
        {
          "term": "cache vs weights",
          "definition": "16.0 GiB cache exceeds the 14 GB weights.",
          "anchor": "b3-p01"
        }
      ],
      "recall": [
        {
          "id": "b3-r1",
          "question": "B3. Write the KV-cache byte formula. Compute it for B=1, T=32768, L=32, n=4096, fp16.",
          "answer": "2 * B * T * L * n * 2 bytes = 17,179,869,184 = 16.0 GiB: exceeds the 14 GB weights.",
          "anchor": "b3-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b4",
      "title": "B4",
      "endAnchor": "b4-end",
      "blocks": [
        {
          "anchor": "b4-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "prefill",
          "definition": "Parallel forward over the prompt; builds the KV cache.",
          "anchor": "b4-p01"
        },
        {
          "term": "TTFT",
          "definition": "Dominated by prefill at long prompts.",
          "anchor": "b4-p01"
        }
      ],
      "recall": [
        {
          "id": "b4-r1",
          "question": "B4. Define prefill. Why is time-to-first-token dominated by prefill at long prompts?",
          "answer": "Parallel forward pass over the prompt that builds the KV cache. Long prompts make it compute-heavy: O(T) dense + O(T^2) attention.",
          "anchor": "b4-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b5",
      "title": "B5",
      "endAnchor": "b5-end",
      "blocks": [
        {
          "anchor": "b5-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "prefill intensity",
          "definition": "~T: compute-bound at long prompts.",
          "anchor": "b5-p01"
        },
        {
          "term": "decode intensity",
          "definition": "~B: memory-bound at batch 1.",
          "anchor": "b5-p01"
        }
      ],
      "recall": [
        {
          "id": "b5-r1",
          "question": "B5. Give prefill and decode arithmetic intensities. Name the bound for each at the toy ridge of 150 FLOP/byte.",
          "answer": "Prefill ~T, decode ~B (batch 1: ~1). At ridge 150: prefill compute-bound at T=2048, decode memory-bound.",
          "anchor": "b5-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b6",
      "title": "B6",
      "endAnchor": "b6-end",
      "blocks": [
        {
          "anchor": "b6-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "E[k]",
          "definition": "Expected accepted tokens per round.",
          "anchor": "b6-p01"
        },
        {
          "term": "bonus token",
          "definition": "The +1: one extra token per round.",
          "anchor": "b6-p01"
        }
      ],
      "recall": [
        {
          "id": "b6-r1",
          "question": "B6. Define the speculative decoding speedup formula with all symbols.",
          "answer": "speedup = E[k]/(gamma*c+1), E[k] = (1-a^{gamma+1})/(1-a).",
          "anchor": "b6-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b7",
      "title": "B7",
      "endAnchor": "b7-end",
      "blocks": [
        {
          "anchor": "b7-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "acceptance rule",
          "definition": "Accept with min(1, p(x)/q(x)).",
          "anchor": "b7-p01"
        },
        {
          "term": "resample distribution",
          "definition": "norm(max(0, p-q)).",
          "anchor": "b7-p01"
        }
      ],
      "recall": [
        {
          "id": "b7-r1",
          "question": "B7. Write the token acceptance rule. What distribution does a rejected token get resampled from?",
          "answer": "Accept with min(1, p(x)/q(x)). Resample from norm(max(0, p-q)).",
          "anchor": "b7-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "b8",
      "title": "B8",
      "endAnchor": "b8-end",
      "blocks": [
        {
          "anchor": "b8-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "shared tokenizer",
          "definition": "Draft and target over the same vocabulary.",
          "anchor": "b8-p01"
        },
        {
          "term": "exact resample",
          "definition": "The residual must complete p exactly.",
          "anchor": "b8-p01"
        }
      ],
      "recall": [
        {
          "id": "b8-r1",
          "question": "B8. State the two exactness assumptions of speculative decoding.",
          "answer": "(1) Same tokenizer/vocabulary. (2) Exact resample distribution. Then output = p exactly.",
          "anchor": "b8-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "deep-ladder-1",
      "title": "Deep ladder 1",
      "endAnchor": "deep-ladder-1-end",
      "blocks": [
        {
          "anchor": "deep-ladder-1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "E[k]",
          "definition": "3.689 on the toy.",
          "anchor": "deep-ladder-1-p01"
        },
        {
          "term": "speedup",
          "definition": "2.95x on the toy; 0.41x in the bad case.",
          "anchor": "deep-ladder-1-p01"
        },
        {
          "term": "constant-a assumption",
          "definition": "Real a_i declines with position.",
          "anchor": "deep-ladder-1-p01"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-1-r1",
          "question": "Deep ladder 1: speculative decoding economics. Define c, gamma, a; compute E[k] and speedup at c=0.05, a=0.8, gamma=5; derive E[k].",
          "answer": "E[k] = 3.689, speedup 2.95x. At a=0.3, c=0.5: 0.41x (2.4x slowdown). E[k] = sum a^i: i drafts accepted with prob a^i, plus the bonus token.",
          "anchor": "deep-ladder-1-p01"
        }
      ],
      "minutes": 3
    },
    {
      "anchor": "deep-ladder-2",
      "title": "Deep ladder 2",
      "endAnchor": "deep-ladder-2-end",
      "blocks": [
        {
          "anchor": "deep-ladder-2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "accept mass",
          "definition": "q*min(1,p/q) = min(q,p).",
          "anchor": "deep-ladder-2-p01"
        },
        {
          "term": "resample mass",
          "definition": "max(0,p-q), covered by resampling.",
          "anchor": "deep-ladder-2-p01"
        },
        {
          "term": "exactness",
          "definition": "Every emitted token distributed exactly as p.",
          "anchor": "deep-ladder-2-p01"
        }
      ],
      "recall": [
        {
          "id": "deep-ladder-2-r1",
          "question": "Deep ladder 2: exactness. Define exact, compute the accept probability for p=[0.2,0.8], q=[0.7,0.3], prove accepted + resample mass = p.",
          "answer": "Accept prob for token 0: 0.2/0.7 = 0.286. Accept mass min(q,p) + residual max(0,p-q) = p.",
          "anchor": "deep-ladder-2-p01"
        }
      ],
      "minutes": 2
    },
    {
      "anchor": "a1",
      "title": "A1",
      "endAnchor": "a1-end",
      "blocks": [
        {
          "anchor": "a1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "dense term",
          "definition": "6PD = 4.2e22.",
          "anchor": "a1-p01"
        },
        {
          "term": "attention share",
          "definition": "7.1% at T=2048, 55.3% at T=32768.",
          "anchor": "a1-p01"
        }
      ],
      "recall": [
        {
          "id": "a1-r1",
          "question": "A1. P=7e9, D=1e12, L=32, n=4096. Compute the dense term 6PD and the attention term 12LnTD at T=2048 and T=32768.",
          "answer": "Dense: 4.2e22. T=2048: attention 3.2e21 (7.1%). T=32768: 5.2e22 (55.3%).",
          "anchor": "a1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "a2",
      "title": "A2",
      "endAnchor": "a2-end",
      "blocks": [
        {
          "anchor": "a2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "E[k]",
          "definition": "5.695 on the toy.",
          "anchor": "a2-p01"
        },
        {
          "term": "break-even a",
          "definition": "~0.415: where E[k] = gamma*c+1.",
          "anchor": "a2-p01"
        }
      ],
      "recall": [
        {
          "id": "a2-r1",
          "question": "A2. a=0.9, gamma=7, c=0.1. Compute E[k] and the speedup. Find the break-even a.",
          "answer": "E[k] = 5.695, speedup 3.35x. Break-even a ~ 0.415.",
          "anchor": "a2-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "d1",
      "title": "D1",
      "endAnchor": "d1-end",
      "blocks": [
        {
          "anchor": "d1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "accept cap",
          "definition": "min(1, p/q), never raw p/q.",
          "anchor": "d1-p01"
        },
        {
          "term": "histogram invariant",
          "definition": "Output histogram equals p.",
          "anchor": "d1-p01"
        }
      ],
      "recall": [
        {
          "id": "d1-r1",
          "question": "D1. The acceptance loop is meant to implement speculative sampling, but the output distribution is wrong. Find the bug, fix it, state the invariant.",
          "answer": "Bugs: (1) accept probability p[x]/q[x] not capped at 1, (2) on reject no resample from norm(max(0,p-q)). Invariant: the output histogram equals p.",
          "anchor": "d1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "s1",
      "title": "S1",
      "endAnchor": "s1-end",
      "blocks": [
        {
          "anchor": "s1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "free draft",
          "definition": "c=0; verification is the cost.",
          "anchor": "s1-p01"
        },
        {
          "term": "gamma=6",
          "definition": "The argmax at a=0.8.",
          "anchor": "s1-p01"
        }
      ],
      "recall": [
        {
          "id": "s1-r1",
          "question": "S1. The draft is free (c=0) but verification costs 1+0.1*gamma steps. Derive the new speedup formula and find the best gamma at a=0.8.",
          "answer": "Speedup = E[k]/(1+0.1*gamma). Best at gamma=6 (2.47x).",
          "anchor": "s1-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "s2",
      "title": "S2",
      "endAnchor": "s2-end",
      "blocks": [
        {
          "anchor": "s2-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "compute-bound decode",
          "definition": "The target step is no longer bandwidth-idle.",
          "anchor": "s2-p01"
        },
        {
          "term": "batch-1 technique",
          "definition": "Where speculation pays.",
          "anchor": "s2-p01"
        }
      ],
      "recall": [
        {
          "id": "s2-r1",
          "question": "S2. Batch is 256 (compute-bound decode). Does speculative decoding still help?",
          "answer": "At batch 256 decode is compute-bound: the free-verification assumption breaks. Speculative decoding is a latency/batch-1 technique.",
          "anchor": "s2-p01"
        }
      ],
      "minutes": 1
    },
    {
      "anchor": "r1",
      "title": "R1",
      "endAnchor": "r1-end",
      "blocks": [
        {
          "anchor": "r1-p01",
          "kind": "keyIdea",
          "reveal": "rise"
        }
      ],
      "keyTerms": [
        {
          "term": "tokenizer audit",
          "definition": "Draft and target must share the tokenizer.",
          "anchor": "r1-p01"
        },
        {
          "term": "baseline audit",
          "definition": "Is the baseline the fastest non-speculative serving?",
          "anchor": "r1-p01"
        }
      ],
      "recall": [
        {
          "id": "r1-r1",
          "question": "R1. A paper claims “3x faster generation with no quality loss” for a new draft architecture. List five audit questions.",
          "answer": "(1) Same tokenizer? (2) Measured a on what workload? (3) Fastest non-speculative baseline? (4) Quality metric? (5) Draft overhead counted?",
          "anchor": "r1-p01"
        }
      ],
      "minutes": 1
    }
  ]
}
