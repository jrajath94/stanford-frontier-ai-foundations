   "blocks": [],
   "keyTerms": [
    {
     "term": "scaling law",
     "definition": "L = E + A·(C/C0)^{-a}; D1's define.",
     "anchor": "d1-power-law-fitting-u10-c01-ol01"
    },
    {
     "term": "residual term",
     "definition": "E, the data floor; D1's define.",
     "anchor": "d1-power-law-fitting-u10-c01-ol01"
    },
    {
     "term": "log-space regression",
     "definition": "log(L-E) = logA - a·log(C/C0); D1's derive.",
     "anchor": "d1-power-law-fitting-u10-c01-ol01"
    }
   ],
